diff --git a/.github/workflows/build-linux.yml b/.github/workflows/build-linux.yml
new file mode 100644
index 0000000..f0fea6e
--- /dev/null
+++ b/.github/workflows/build-linux.yml
@@ -0,0 +1,90 @@
+name: Linux builds
+
+on:
+  workflow_dispatch:
+  push:
+    tags: ['v*']
+
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-go@v5
+        with:
+          go-version: '1.23.x'
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: requirements-assets.txt
+      - run: python -m pip install -r requirements-assets.txt
+      - run: python scripts/generate_signature_themes.py
+      - run: go test ./...
+      - run: go vet ./...
+      - run: go test -race ./...
+
+  build:
+    needs: test
+    strategy:
+      matrix:
+        arch: [amd64, arm64]
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-go@v5
+        with:
+          go-version: '1.23.x'
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: requirements-assets.txt
+      - run: python -m pip install -r requirements-assets.txt
+      - name: Rebuild official themes
+        run: python scripts/generate_signature_themes.py
+      - name: Cross-compile Linux binaries
+        env:
+          GOOS: linux
+          GOARCH: ${{ matrix.arch }}
+          CGO_ENABLED: '0'
+          VERSION: ${{ startsWith(github.ref, 'refs/tags/v') && github.ref_name || '0.9.0-dev' }}
+        run: |
+          mkdir -p dist/linux-desktop-customizer-linux-${GOARCH}
+          LDFLAGS="-s -w -X linux-theme-commons/internal/version.Value=${VERSION}"
+          go build -trimpath -ldflags="$LDFLAGS" -o dist/linux-desktop-customizer-linux-${GOARCH}/ltc ./cmd/ltc
+          go build -trimpath -ldflags="$LDFLAGS" -o dist/linux-desktop-customizer-linux-${GOARCH}/ltc-ui ./cmd/ltc-ui
+          cp packaging/install-user.sh packaging/uninstall-user.sh README.md LICENSE dist/linux-desktop-customizer-linux-${GOARCH}/
+          mkdir -p dist/linux-desktop-customizer-linux-${GOARCH}/themes
+          cp -R themes/official dist/linux-desktop-customizer-linux-${GOARCH}/themes/
+          tar -C dist -czf dist/linux-desktop-customizer-linux-${GOARCH}.tar.gz linux-desktop-customizer-linux-${GOARCH}
+      - uses: actions/upload-artifact@v4
+        with:
+          name: linux-desktop-customizer-linux-${{ matrix.arch }}
+          path: dist/linux-desktop-customizer-linux-${{ matrix.arch }}.tar.gz
+
+  release:
+    if: startsWith(github.ref, 'refs/tags/v')
+    needs: build
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          pattern: linux-desktop-customizer-linux-*
+          path: dist
+          merge-multiple: true
+      - name: Checksums
+        run: (cd dist && sha256sum *.tar.gz > SHA256SUMS.txt)
+      - name: Publish GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ github.ref_name }}
+        run: |
+          gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1 || \
+            gh release create "$TAG" --repo "$GITHUB_REPOSITORY" --title "$TAG" --generate-notes
+          gh release upload "$TAG" dist/*.tar.gz dist/SHA256SUMS.txt --repo "$GITHUB_REPOSITORY" --clobber
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..d44ce4c
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,39 @@
+name: CI
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-go@v5
+        with:
+          go-version: '1.23.x'
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: requirements-assets.txt
+      - name: Install asset generator dependencies
+        run: python -m pip install -r requirements-assets.txt
+      - name: Rebuild official themes
+        run: |
+          python scripts/generate_signature_themes.py
+          mkdir -p assets/theme-previews
+          for slug in fire water wind earth mac-inspired windows-inspired; do
+            cp "themes/official/$slug/preview.png" "assets/theme-previews/$slug.png"
+          done
+      - name: Verify generated assets are committed
+        run: git diff --exit-code -- themes/official assets/theme-previews
+      - run: go test ./...
+      - run: go vet ./...
+      - run: go test -race ./...
+      - run: git diff --check
+      - run: go build ./cmd/ltc
+      - run: go build ./cmd/ltc-ui

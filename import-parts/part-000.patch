--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/bug.yml
@@ -0,0 +1,45 @@
+name: Bug report
+description: Report a reproducible problem after reviewing what you choose to share
+title: "[Bug] "
+body:
+  - type: markdown
+    attributes:
+      value: |
+        Linux Desktop Customizer never uploads diagnostics automatically. Please share only information you have reviewed and are comfortable making public.
+  - type: textarea
+    attributes:
+      label: What happened?
+    validations:
+      required: true
+  - type: input
+    attributes:
+      label: Linux distribution and version
+    validations:
+      required: true
+  - type: input
+    attributes:
+      label: Desktop/session
+      description: e.g. KDE Plasma 6 / Wayland
+    validations:
+      required: true
+  - type: input
+    attributes:
+      label: Linux Desktop Customizer version
+      description: Output of `ltc version`
+    validations:
+      required: true
+  - type: textarea
+    attributes:
+      label: Steps to reproduce
+    validations:
+      required: true
+  - type: textarea
+    attributes:
+      label: Optional sanitized diagnostics
+      description: Review `ltc diagnostics` before pasting anything here. Do not include secrets or private files.
+  - type: checkboxes
+    attributes:
+      label: Privacy check
+      options:
+        - label: I reviewed the information above and chose to submit it publicly.
+          required: true
